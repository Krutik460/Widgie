{
  "type": "vstack",
  "align": "leading",
  "spacing": 6,
  "padding": 16,
  "frame": { "maxWidth": "infinity", "maxHeight": "infinity", "alignment": "topLeading" },
  "widgetBackground": { "gradient": "linear", "stops": ["#F7F0E3", "#EFE4D0"], "from": "top", "to": "bottom" },
  "children": [
    {
      "type": "hstack",
      "align": "top",
      "spacing": 8,
      "children": [
        {
          "type": "text",
          "value": "{{ data.word == '' ? '' : data.word[0] }}",
          "size": 64,
          "weight": "bold",
          "design": "serif",
          "color": "#7A0E1A",
          "lineLimit": 1
        },
        {
          "type": "vstack",
          "align": "leading",
          "spacing": 2,
          "frame": { "maxWidth": "infinity", "alignment": "topLeading" },
          "children": [
            { "type": "text", "value": "{{ data.word }}", "size": 17, "weight": "bold", "design": "serif", "italic": true, "color": "#3A0A10", "lineLimit": 1, "minScale": 0.6 },
            { "type": "text", "value": "{{ data.partOfSpeech }}", "size": 11, "design": "serif", "italic": true, "color": "#8A2A34", "lineLimit": 1 }
          ]
        }
      ]
    },
    { "type": "rect", "fill": "#7A0E1A", "frame": { "maxWidth": "infinity", "height": 1 } },
    {
      "type": "text",
      "value": "{{ data.definition }}",
      "size": 12,
      "design": "serif",
      "color": "#3A0A10",
      "lineLimit": "{{ family == 'medium' ? 4 : 3 }}",
      "minScale": 0.7
    },
    {
      "type": "if",
      "test": "{{ family == 'medium' }}",
      "then": [
        {
          "type": "text",
          "value": "“{{ data.example }}”",
          "size": 12,
          "design": "serif",
          "italic": true,
          "color": "#8A2A34",
          "lineLimit": 2,
          "minScale": 0.7
        }
      ]
    },
    { "type": "spacer" },
    {
      "type": "text",
      "value": "{{ data.date }}",
      "size": 9,
      "design": "serif",
      "weight": "medium",
      "color": "#8A2A34"
    }
  ]
}
