{
  "type": "zstack",
  "frame": { "maxWidth": "infinity", "maxHeight": "infinity" },
  "widgetBackground": "#FFF176",
  "children": [
    {
      "type": "vstack",
      "align": "leading",
      "spacing": 4,
      "padding": { "top": 12, "bottom": 10, "leading": 14, "trailing": 14 },
      "frame": { "maxWidth": "infinity", "maxHeight": "infinity", "alignment": "topLeading" },
      "children": [
        {
          "type": "hstack",
          "spacing": 6,
          "children": [
            { "type": "text", "value": "To do", "size": 16, "weight": "bold", "design": "rounded", "italic": true, "color": "#5D4E00", "lineLimit": 1 },
            { "type": "spacer" },
            { "type": "text", "value": "{{ data.doneCount }}/{{ data.total }}", "size": 12, "weight": "semibold", "design": "rounded", "color": "#8A7A1C" }
          ]
        },
        {
          "type": "vstack",
          "align": "leading",
          "spacing": 3,
          "children": [
            {
              "type": "repeat",
              "over": "{{ data.items }}",
              "item": "t",
              "index": "i",
              "children": [
                {
                  "type": "if",
                  "test": "{{ i < (family == 'medium' ? 6 : 4) }}",
                  "then": [
                    {
                      "type": "button",
                      "action": "toggleDone",
                      "rowId": "{{ t.id }}",
                      "children": [
                        {
                          "type": "hstack",
                          "spacing": 6,
                          "opacity": "{{ t.done ? 0.45 : 1 }}",
                          "children": [
                            {
                              "type": "symbol",
                              "name": "{{ t.done ? 'checkmark.circle.fill' : 'circle' }}",
                              "size": 13,
                              "color": "#5D4E00"
                            },
                            {
                              "type": "text",
                              "value": "{{ t.title }}",
                              "size": 14,
                              "design": "rounded",
                              "italic": true,
                              "color": "#3E3400",
                              "strikethrough": "{{ t.done }}",
                              "lineLimit": 1,
                              "minScale": 0.7
                            }
                          ]
                        }
                      ]
                    }
                  ]
                }
              ]
            }
          ]
        },
        { "type": "spacer" },
        {
          "type": "hstack",
          "children": [
            { "type": "spacer" },
            {
              "type": "button",
              "action": "openAdd",
              "children": [
                {
                  "type": "symbol",
                  "name": "plus",
                  "size": 12,
                  "weight": "bold",
                  "color": "#FFF176",
                  "frame": { "width": 26, "height": 26 },
                  "background": "#5D4E00",
                  "clip": "circle"
                }
              ]
            }
          ]
        }
      ]
    }
  ],
  "rotation": -2,
  "shadow": { "color": "#00000033", "radius": 4, "x": 1, "y": 3 }
}
