#!/usr/bin/env bash
# Generates Widgie.xcodeproj from project.yml, builds the app and the widget extension for the simulator, and
# runs the app's unit tests there. Exits non-zero on the first failure. Products land in App/.build/.
set -euo pipefail

app="$(cd "$(dirname "$0")/.." && pwd)"
cd "$app"

printf '\n== format\n'
config="$app/../Engine/.swift-format"
if ! swift format lint --strict --recursive --configuration "$config" Widgie WidgieWidgets WidgieTests; then
    echo "fix with: swift format format --in-place --recursive --configuration $config Widgie WidgieWidgets WidgieTests" >&2
    exit 1
fi

printf '\n== generate\n'
xcodegen generate --quiet

printf '\n== simulator build and app tests\n'
# Xcode's built-in git stalls cloning GRDB; the system git does not.
xcodebuild -project Widgie.xcodeproj -scheme Widgie -configuration Debug \
    -destination "platform=iOS Simulator,name=${WIDGIE_SIMULATOR:-iPhone 18 Pro}" -derivedDataPath .build \
    -scmProvider system -quiet test

printf '\nbuild passed: %s\n' "$app/.build/Build/Products/Debug-iphonesimulator/Widgie.app"
