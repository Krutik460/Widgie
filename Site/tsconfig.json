{
    "compilerOptions": {
        "target": "es2024",
        "lib": ["es2024"],
        "module": "esnext",
        "moduleResolution": "bundler",
        "types": ["@cloudflare/workers-types", "@cloudflare/vitest-plugin/types"],
        "strict": true,
        "noUncheckedIndexedAccess": true,
        "resolveJsonModule": true,
        "noEmit": true,
        "skipLibCheck": true,
        "allowJs": true
    },
    "include": ["src", "test", "vitest.config.ts", "public/channels.js"]
}
