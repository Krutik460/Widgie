#!/usr/bin/env bash
# Formatting, the release build, the tests, and the module rules of docs/engine/MODULES.md.
# Exits non-zero at the first failing step.
set -euo pipefail

engine="$(cd "$(dirname "$0")/.." && pwd)"
modules="$engine/../docs/engine/MODULES.md"
frameworks=/Library/Developer/CommandLineTools/Library/Developer/Frameworks
cd "$engine"

step() { printf '\n== %s\n' "$1"; }

step "format"
if ! swift format lint --strict --recursive Package.swift Sources Tests; then
    echo "fix with: swift format format --in-place --recursive Package.swift Sources Tests" >&2
    exit 1
fi

step "release build"
swift build -c release --build-system native

step "tests"
swift test --build-system native -Xswiftc "-F$frameworks" -Xlinker -rpath -Xlinker "$frameworks"

step "module rules from docs/engine/MODULES.md"
table="$(awk '/^## / { inside = ($0 == "## Targets") } inside && /^\| `[A-Za-z]+` \|/' "$modules")"
if [ -z "$table" ]; then
    echo "no rows in the Targets table of $modules" >&2
    exit 1
fi

failed=0
internal=""
for dir in Sources/*/; do
    target="$(basename "$dir")"
    row="$(printf '%s\n' "$table" | awk -F'|' -v want="\`$target\`" '{ name = $2; gsub(/ /, "", name) } name == want')"
    if [ -z "$row" ]; then
        echo "$target has no row in the Targets table of MODULES.md" >&2
        failed=1
        continue
    fi
    allowed="$(printf '%s\n' "$row" | awk -F'|' '{ print $4 }' | tr -d ' `')"
    imports="$(grep -rhoE '^[[:space:]]*(@[A-Za-z_]+[[:space:]]+)*((public|package|internal|private|fileprivate)[[:space:]]+)?import[[:space:]]+((struct|class|enum|protocol|typealias|func|var|let)[[:space:]]+)?[A-Za-z_][A-Za-z0-9_]*' "$dir" | awk '{ print $NF }' | sort -u || true)"
    for module in $imports; do
        case ",$allowed," in
        *",$module,"*) ;;
        *)
            echo "$target imports $module, but MODULES.md allows only $allowed" >&2
            failed=1
            ;;
        esac
    done
    if printf '%s\n' "$row" | awk -F'|' '{ print $5 }' | grep -q '`package` only'; then
        internal="$internal $target"
        if grep -rnE '^[^/"]*(^|[^A-Za-z0-9_])public([^A-Za-z0-9_]|$)' "$dir" >&2; then
            echo "$target is package-internal, so it must not declare anything public (lines above)" >&2
            failed=1
        fi
    fi
done
if [ "$failed" -ne 0 ]; then
    exit 1
fi
echo "every target imports only what MODULES.md allows; nothing public in:$internal"

printf '\ncheck passed\n'
