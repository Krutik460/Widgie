// The top level is production. Environments inherit no vars, secrets, or bindings, so each declares its own.
// Secrets per environment: OPENROUTER_API_KEY, and OPERATOR_TOKEN on dev only, until B2 removes it.
{
    "$schema": "node_modules/wrangler/config-schema.json",
    "name": "widgie",
    "main": "src/index.ts",
    "compatibility_date": "2026-08-15",
    "observability": { "enabled": true },
    "vars": { "MODEL": "anthropic/claude-sonnet-5.5", "PROVIDER": "amazon-bedrock" },
    "env": {
        "dev": {
            "name": "widgie-dev",
            "vars": { "MODEL": "anthropic/claude-sonnet-5.5", "PROVIDER": "amazon-bedrock" }
        }
    }
}
