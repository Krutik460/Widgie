// The top level is production. Environments inherit no vars, secrets, or bindings, so each declares its own.
// Secret per environment: MODEL_API_KEY. Secret on dev only: DEV_REGISTRATION_SECRET, which lets the simulator
// register an account without App Attest; production refuses it even if it were set, because ENVIRONMENT is not "dev".
// MODEL_URL is any OpenAI-compatible chat completions endpoint: OpenRouter here, or Bedrock Mantle
// (https://bedrock-mantle.us-east-1.api.aws/v1/chat/completions, with PROVIDER empty). PROVIDER pins one OpenRouter
// provider: Together serves DeepSeek V4.1 Flash at full precision and does not train on requests. REASONING is
// "off", "low", "medium", "high", or empty to send nothing. STRUCTURED_OUTPUT "on" sends an automation run's JSON
// schema as response_format and requires the provider to honor it; Together lists response_format and
// structured_outputs for this model on OpenRouter (checked 2026-11-27). Turn it off for an endpoint that does not.
// App Attest: APP_ID is `<team id>.<bundle id>`, whose SHA-256 every attestation and assertion carries. ATTEST_ENV is
// the App Attest environment an attestation must name: "development" for Debug builds against dev, "production" for
// Release builds. ATTESTED_KEY is one SQLite-backed Durable Object per App Attest key (public key, counter, pending
// challenge). The class was created SQLite-backed (migration v1) and can never change backend. There are no usage
// limits for now (no attest rate limit, no daily quota); they come back later.
// DB is the environment's D1 database (accounts, automations, tasks, changes), its schema in migrations/.
// The database ids are the ones `npx wrangler d1 create widgie` and `npx wrangler d1 create widgie-dev` printed
// on 2026-11-27; migrations apply with `npx wrangler d1 migrations apply <name> [--env dev] --remote`.
// Crons (src/cron.ts, which names the same two strings): every minute the due automation runs are claimed and sent to
// the RUNS queue; at 03:17 UTC the upkeep parks and deletes idle accounts and deletes old changes. The Worker consumes
// its own queue one run per batch, so each run has its own invocation and CPU budget (10 ms on Workers Free), at most
// 20 at once, so at most 20 calls reach OpenRouter together. A run that throws is retried twice, a minute apart, and
// then kept in the dead-letter queue; its task is claimed again either way.
// Create the queues with `npx wrangler queues create widgie-runs`, `widgie-runs-dead`, `widgie-dev-runs`, and
// `widgie-dev-runs-dead` before the first deploy.
{
    "$schema": "node_modules/wrangler/config-schema.json",
    "name": "widgie",
    "main": "src/index.ts",
    "compatibility_date": "2026-08-15",
    "observability": { "enabled": true },
    "vars": {
        "ENVIRONMENT": "production",
        "MODEL_URL": "https://openrouter.ai/api/v1/chat/completions",
        "MODEL": "deepseek/deepseek-v4.1-flash-1017",
        "PROVIDER": "together",
        "REASONING": "low",
        "STRUCTURED_OUTPUT": "on",
        "APP_ID": "Z23KXVBB26.dev.krutikpatel.widgie",
        "ATTEST_ENV": "production"
    },
    "durable_objects": { "bindings": [{ "name": "ATTESTED_KEY", "class_name": "AttestedKey" }] },
    "migrations": [{ "tag": "v1", "new_sqlite_classes": ["AttestedKey"] }],
    "d1_databases": [
        {
            "binding": "DB",
            "database_name": "widgie",
            "database_id": "65687cf8-3c32-40fe-b9b5-ca997dc1c34a",
            "migrations_dir": "migrations"
        }
    ],
    "triggers": { "crons": ["* * * * *", "17 3 * * *"] },
    "queues": {
        "producers": [{ "binding": "RUNS", "queue": "widgie-runs" }],
        "consumers": [
            {
                "queue": "widgie-runs",
                "max_batch_size": 1,
                "max_batch_timeout": 5,
                "max_retries": 2,
                "max_concurrency": 20,
                "dead_letter_queue": "widgie-runs-dead"
            }
        ]
    },
    "env": {
        "dev": {
            "name": "widgie-dev",
            "vars": {
                "ENVIRONMENT": "dev",
                "MODEL_URL": "https://openrouter.ai/api/v1/chat/completions",
                "MODEL": "deepseek/deepseek-v4.1-flash-1017",
                "PROVIDER": "together",
                "REASONING": "low",
                "STRUCTURED_OUTPUT": "on",
                "APP_ID": "Z23KXVBB26.dev.krutikpatel.widgie",
                "ATTEST_ENV": "development"
            },
            "durable_objects": { "bindings": [{ "name": "ATTESTED_KEY", "class_name": "AttestedKey" }] },
            "migrations": [{ "tag": "v1", "new_sqlite_classes": ["AttestedKey"] }],
            "d1_databases": [
                {
                    "binding": "DB",
                    "database_name": "widgie-dev",
                    "database_id": "0c808e1e-cdfc-419f-82a7-4592eebe0bcf",
                    "migrations_dir": "migrations"
                }
            ],
            "triggers": { "crons": ["* * * * *", "17 3 * * *"] },
            "queues": {
                "producers": [{ "binding": "RUNS", "queue": "widgie-dev-runs" }],
                "consumers": [
                    {
                        "queue": "widgie-dev-runs",
                        "max_batch_size": 1,
                        "max_batch_timeout": 5,
                        "max_retries": 2,
                        "max_concurrency": 20,
                        "dead_letter_queue": "widgie-dev-runs-dead"
                    }
                ]
            }
        }
    }
}
